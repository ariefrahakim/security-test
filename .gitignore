# Secrets — jangan pernah commit
.env
*.pem
*.key
*_secret*
*_credentials*
tokens.txt
cookies.txt
cookies.json
**/evidence/**/cookies.json
**/*session*.json

# Burp
*.burp
burp-project-*

# Screenshots berat / video PoC — pertimbangkan Git LFS
*.mp4
*.mov

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Node
node_modules/

# Bug bounty target notes (sensitive assets)
private-recon/
scope-notes/

# Agent request log — internal telemetry, don't commit
reports/_agent-log/

# Raw evidence bodies — may contain PII in future runs. Exclude by default;
# comment out the next line if you want to commit sample raw evidence.
# reports/**/raw/
