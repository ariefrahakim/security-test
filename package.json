{
  "name": "sec-agent",
  "version": "0.2.0",
  "private": true,
  "description": "Agentic, authorization-gated web application security tester.",
  "scripts": {
    "sec-test": "./scripts/run.sh",
    "walkthrough": "node scripts/authenticated-walkthrough.js",
    "triage": "node scripts/triage.js",
    "build-report": "node scripts/build-report.js",
    "report": "node scripts/open-latest-report.js",
    "report:list": "ls -1 reports | grep -v _agent-log",
    "compare": "node scripts/compare-reports.js",
    "report:compare": "open reports/_comparison-emha-vs-onebid/comparison.html || xdg-open reports/_comparison-emha-vs-onebid/comparison.html"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "playwright": "^1.62.1"
  }
}
