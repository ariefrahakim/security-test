# Target for the sec-agent. Change this and re-run — everything else is derived.
TARGET_WEB=https://your-target.example.com

# Optional test credentials (used only if you explicitly enable auth-flow tests).
EMAIL=
PASSWORD=

# Authorization type: owner | written-permission | bugbounty-scope | internal-authorized
AUTHORIZATION_TYPE=owner
AUTHORIZATION_NOTE=I own this domain / I have written permission.

# Optional: extra hosts to treat as in-scope (comma-separated). Leave blank to test only TARGET_WEB's host.
EXTRA_IN_SCOPE_HOSTS=

# Optional: forbidden path prefixes on the target (comma-separated).
OUT_OF_SCOPE_PATHS=

# Rate: max requests per minute per host.
MAX_RPM=60

# Killswitch — set to 1 to halt all agent activity immediately.
SEC_AGENT_KILL=0
