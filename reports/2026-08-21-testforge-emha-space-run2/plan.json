{
  "run_id": "2026-08-21-testforge-emha-space-run2",
  "target": "https://testforge.emha.space",
  "authorization": { "type": "owner", "note": "Domain owner (Arief Rahman Hakim). Confirmed 2026-08-21." },
  "coa": "C — authenticated walk-through with Playwright + module-organized report",
  "phases": [
    { "n": 1, "name": "Recon (passive)",       "delegate": "sec-recon",   "artifacts": ["findings.recon.json", "raw/*"] },
    { "n": 2, "name": "Hypothesize",           "delegate": "self",        "artifacts": ["hypotheses.json"] },
    { "n": 3, "name": "Authenticated verify",  "delegate": "sec-verify",  "artifacts": ["walkthrough.json", "findings.verified.json", "evidence/*"] },
    { "n": 4, "name": "Triage / dedupe",       "delegate": "self",        "artifacts": ["findings.final.json"] },
    { "n": 5, "name": "Report build",          "delegate": "build-report","artifacts": ["report.html", "report.json", "report.md"] },
    { "n": 6, "name": "Hand-off",              "delegate": "self",        "artifacts": ["exec-summary in chat"] }
  ],
  "rails": {
    "scope_check": "./scripts/scope-check.sh on every URL",
    "max_rpm": 60,
    "killswitch": "SEC_AGENT_KILL=1",
    "hitl": "one-at-a-time approval for any state-changing request; read-only probing autonomous"
  },
  "estimated_requests": "150-300 authenticated navigations + ~20 header probes"
}
