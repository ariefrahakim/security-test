  "findings": [
    {
      "id": "V-D01",
      "module": "dashboard",
      "sev": "INFO",
      "confidence": "heuristic",
      "category": "A03:2021 Injection",
      "cwe": "CWE-79",
      "title": "Query-string values reflected into Next.js RSC JSON payload (not an HTML sink)",
      "evidence": "All 11 probed GET params (q, search, filter, project, view, tab, ref, id, name, sort, page) with canary value zzq...xx were echoed by /dashboard inside a <script> block as JSON-encoded strings under __NEXT_DATA__.urlParts. Context excerpt: `\"urlParts\":[\"\",\"dashboard?q=zzqmt3529kvxx\"]`. JSON encoding prevents breakout to HTML/JS execution context. See evidence/dashboard/reflect-*.html.",
      "evidence_path": "reports/2026-08-21-testforge-emha-space-dashboard/evidence/dashboard/reflect-q.html",
      "cvss4": {
        "vector": "CVSS:4.0/AV:N/AC:L/AT:P/PR:N/UI:A/VC:N/VI:N/VA:N/SC:N/SI:N/SA:N",
        "score": 0
      },
      "recommendation": "No direct action required — JSON serialisation is the defence. As defence-in-depth, ship a strict Content-Security-Policy (script-src 'self' with nonces) so that even if a future refactor moves the value into an unsafe sink, execution is blocked.",
      "chain_of_attack": "Attacker crafts a link with a payload in any query parameter and shares it. Server echoes value into __NEXT_DATA__ JSON blob. Because value is inside a JSON string literal in a <script type=\"application/json\"> context, the payload cannot escape the string quotes to reach a JS execution context — no XSS. Impact = None until/unless the code path changes.",
      "retest": "curl -s 'https://testforge.emha.space/dashboard?q=%3Csvg/onload=alert(1)%3E' | grep -o 'urlParts[^]]*' | head -1",
      "_impact": "Informational — no exploit path observed.",
      "_effort": "Optional — best-practice tightening.",
      "_owner": "Backend + Frontend"
    },
